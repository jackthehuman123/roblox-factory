--!strict
-- Writes the asset catalogue tables (index, images) as Luau source.
local Catalog = require("./Catalog")

local Serialize = {}

local HEADER = "--!strict\n-- generated by tools/asset_db\n"

local function strings(list: { string }): string
	local out: { string } = {}
	for _, s in list do
		table.insert(out, string.format("%q", s))
	end
	return `\{ {table.concat(out, ", ")} }`
end

function Serialize.index(index: { Catalog.IndexEntry }): string
	local lines = { HEADER .. "return {" }
	for _, e in index do
		local size: { string } = {}
		for _, n in e.size do
			table.insert(size, string.format("%.17g", n))
		end
		local f = {
			`name = {string.format("%q", e.name)}`,
			`tags = {strings(e.tags)}`,
			`size = \{ {table.concat(size, ", ")} }`,
			`sources = {strings(e.sources)}`,
			`built = {string.format("%q", e.built)}`,
			`review = {string.format("%q", e.review)}`,
		}
		if e.note ~= nil then
			table.insert(f, `note = {string.format("%q", e.note)}`)
		end
		if e.reason ~= nil then
			table.insert(f, `reason = {string.format("%q", e.reason)}`)
		end
		if e.gens ~= nil then
			table.insert(f, `gens = {e.gens}`)
		end
		if e.measure ~= nil then
			table.insert(f, `measure = {string.format("%q", e.measure)}`)
		end
		table.insert(lines, `\t\{ {table.concat(f, ", ")} },`)
	end
	table.insert(lines, "}\n")
	return table.concat(lines, "\n")
end

function Serialize.images(images: { Catalog.ImageEntry }): string
	local lines = { HEADER .. "return {" }
	for _, img in images do
		local skipped: { string } = {}
		for _, s in img.skipped do
			table.insert(skipped, `\{ object = {string.format("%q", s.object)}, why = {string.format("%q", s.why)} }`)
		end
		local f = {
			`file = {string.format("%q", img.file)}`,
			`hash = {string.format("%q", img.hash)}`,
			`status = {string.format("%q", img.status)}`,
			`built = {strings(img.built)}`,
			`skipped = \{ {table.concat(skipped, ", ")} }`,
		}
		table.insert(lines, `\t\{ {table.concat(f, ", ")} },`)
	end
	table.insert(lines, "}\n")
	return table.concat(lines, "\n")
end

return Serialize
